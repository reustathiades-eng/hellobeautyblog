<!-- ============================================================================
     SECTION 1: HERO
============================================================================= -->
<section class="hero-section"{{ if eq $lang "ar" }} dir="rtl"{{ end }}>
    <div class="hero-background">
        <div class="hero-gradient"></div>
        <div class="hero-pattern"></div>
    </div>
    
    <div class="hero-container">
        <div class="hero-content">
            <h1 class="hero-title">
                {{ $heroTitle }} <span class="hero-highlight">{{ $heroHighlight }}</span>
            </h1>
            <p class="hero-subtitle">{{ $heroSubtitle }}</p>
            <div class="hero-cta">
                <a href="/{{ $lang }}/{{ $perfumesSlug }}/" class="btn-primary">
                    <svg class="btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                    </svg>
                    {{ $heroCTA }}
                </a>
                <a href="#categories" class="btn-secondary">
                    {{ $heroSecondaryCTA }}
                    <svg class="btn-icon-right" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                </a>
            </div>
            
            <!-- Stats -->
            <div class="hero-stats">
                <div class="stat">
                    <span class="stat-number">500+</span>
                    <span class="stat-label">{{ if eq $lang "fr" }}Produits testés{{ else if eq $lang "de" }}Getestete Produkte{{ else if eq $lang "es" }}Productos probados{{ else }}Products Reviewed{{ end }}</span>
                </div>
                <div class="stat-divider"></div>
                <div class="stat">
                    <span class="stat-number">14</span>
                    <span class="stat-label">{{ if eq $lang "fr" }}Langues{{ else if eq $lang "de" }}Sprachen{{ else if eq $lang "es" }}Idiomas{{ else }}Languages{{ end }}</span>
                </div>
                <div class="stat-divider"></div>
                <div class="stat">
                    <span class="stat-number">100%</span>
                    <span class="stat-label">{{ if eq $lang "fr" }}Indépendant{{ else if eq $lang "de" }}Unabhängig{{ else if eq $lang "es" }}Independiente{{ else }}Independent{{ end }}</span>
                </div>
            </div>
        </div>
        
        <div class="hero-visual">
            <div class="hero-image-container">
                <img src="/images/hero/hero-main.webp" alt="Hello Beauty - Luxury Perfumes and Skincare" class="hero-image" loading="eager">
                <div class="hero-image-decoration"></div>
            </div>
            
            <!-- Dynamic Floating Product Cards -->
            {{ $perfumesSlugLocal := "perfumes" }}
            {{ if eq $lang "fr" }}{{ $perfumesSlugLocal = "parfums" }}
            {{ else if eq $lang "de" }}{{ $perfumesSlugLocal = "parfum" }}
            {{ else if eq $lang "it" }}{{ $perfumesSlugLocal = "profumi" }}
            {{ else if eq $lang "nl" }}{{ $perfumesSlugLocal = "parfum" }}
            {{ else if eq $lang "pl" }}{{ $perfumesSlugLocal = "perfumy" }}
            {{ else if eq $lang "tr" }}{{ $perfumesSlugLocal = "parfum" }}
            {{ end }}
            
            <!-- Latest Women's Perfume -->
            {{ $womenPerfumes := where (where site.RegularPages "Section" "perfumes") "Params.gender" "Women" }}
            {{ $latestWomen := first 1 (sort $womenPerfumes "Date" "desc") }}
            {{ range $latestWomen }}
            <a href="{{ .Permalink }}" class="floating-card floating-card-1" title="{{ .Params.brand }} {{ .Params.productName }}">
                {{ $img := index .Params.images 0 }}
                <img src="{{ $img }}" alt="{{ .Params.brand }} {{ .Params.productName }}">
                <span class="floating-label">{{ if eq $lang "fr" }}Parfum Femme{{ else }}Women{{ end }}</span>
            </a>
            {{ end }}
            
            <!-- Latest Men's Perfume -->
            {{ $menPerfumes := where (where site.RegularPages "Section" "perfumes") "Params.gender" "Men" }}
            {{ $latestMen := first 1 (sort $menPerfumes "Date" "desc") }}
            {{ range $latestMen }}
            <a href="{{ .Permalink }}" class="floating-card floating-card-2" title="{{ .Params.brand }} {{ .Params.productName }}">
                {{ $img := index .Params.images 0 }}
                <img src="{{ $img }}" alt="{{ .Params.brand }} {{ .Params.productName }}">
                <span class="floating-label">{{ if eq $lang "fr" }}Parfum Homme{{ else }}Men{{ end }}</span>
            </a>
            {{ end }}
            
            <!-- Latest Skincare -->
            {{ $skincare := where site.RegularPages "Section" "skincare" }}
            {{ $latestSkincare := first 1 (sort $skincare "Date" "desc") }}
            {{ range $latestSkincare }}
            <a href="{{ .Permalink }}" class="floating-card floating-card-3" title="{{ .Title }}">
                {{ $img := index .Params.images 0 }}
                <img src="{{ $img }}" alt="{{ .Title }}">
                <span class="floating-label">{{ if eq $lang "fr" }}Soins{{ else }}Skincare{{ end }}</span>
            </a>
            {{ end }}
            
            <!-- Latest Makeup -->
            {{ $makeup := where site.RegularPages "Section" "makeup" }}
            {{ $latestMakeup := first 1 (sort $makeup "Date" "desc") }}
            {{ range $latestMakeup }}
            <a href="{{ .Permalink }}" class="floating-card floating-card-4" title="{{ .Title }}">
                {{ $img := index .Params.images 0 }}
                <img src="{{ $img }}" alt="{{ .Title }}">
                <span class="floating-label">{{ if eq $lang "fr" }}Maquillage{{ else }}Makeup{{ end }}</span>
            </a>
            {{ end }}
            
            <!-- Latest Haircare -->
            {{ $haircare := where site.RegularPages "Section" "haircare" }}
            {{ $latestHaircare := first 1 (sort $haircare "Date" "desc") }}
            {{ range $latestHaircare }}
            <a href="{{ .Permalink }}" class="floating-card floating-card-5" title="{{ .Title }}">
                {{ $img := index .Params.images 0 }}
                <img src="{{ $img }}" alt="{{ .Title }}">
                <span class="floating-label">{{ if eq $lang "fr" }}Cheveux{{ else }}Haircare{{ end }}</span>
            </a>
            {{ end }}
        </div>
    </div>
    
    <!-- Scroll indicator -->
    <div class="scroll-indicator">
        <span>Scroll</span>
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
        </svg>
    </div>
</section>

<!-- ============================================================================
     SECTION 2: INTRO SEO
============================================================================= -->
<section class="intro-section">
    <div class="intro-container">
        <div class="intro-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
        </div>
        <h2 class="intro-title">{{ $introTitle }}</h2>
        <div class="intro-text">
            <p>{{ $introText }}</p>
        </div>
    </div>
</section>

<!-- ============================================================================
     SECTION 3: CATEGORIES
============================================================================= -->
<section id="categories" class="categories-section">
    <div class="categories-container">
        <div class="section-header">
            <h2 class="section-title">{{ $categoriesTitle }}</h2>
            <p class="section-subtitle">{{ $categoriesSubtitle }}</p>
        </div>
        
        <div class="categories-grid">
            <!-- Perfumes - Featured (larger) -->
            <a href="/{{ $lang }}/{{ $perfumesSlug }}/" class="category-card category-featured">
                <div class="category-image">
                    <img src="/images/categories/perfumes.webp?v=2" alt="{{ $catPerfumes }}" loading="lazy">
                    <div class="category-overlay"></div>
                </div>
                <div class="category-content">
                    <div class="category-icon"><img src="/images/icons/icon-perfumes.webp?v=2" alt=""></div>
                    <h3 class="category-name">{{ $catPerfumes }}</h3>
                    <p class="category-desc">{{ $catPerfumesDesc }}</p>
                    <span class="category-link">
                        {{ $viewAll }} →
                    </span>
                </div>
            </a>
            
            <!-- Other categories -->
            <a href="/{{ $lang }}/{{ $skincareSlug }}/" class="category-card">
                <div class="category-image">
                    <img src="/images/categories/skincare.webp?v=2" alt="{{ $catSkincare }}" loading="lazy">
                    <div class="category-overlay"></div>
                </div>
                <div class="category-content">
                    <div class="category-icon"><img src="/images/icons/icon-skincare.webp?v=2" alt=""></div>
                    <h3 class="category-name">{{ $catSkincare }}</h3>
                    <p class="category-desc">{{ $catSkincareDesc }}</p>
                    <span class="category-link">{{ $viewAll }} →</span>
                </div>
            </a>
            
            <a href="/{{ $lang }}/{{ $makeupSlug }}/" class="category-card">
                <div class="category-image">
                    <img src="/images/categories/makeup.webp?v=2" alt="{{ $catMakeup }}" loading="lazy">
                    <div class="category-overlay"></div>
                </div>
                <div class="category-content">
                    <div class="category-icon"><img src="/images/icons/icon-makeup.webp?v=2" alt=""></div>
                    <h3 class="category-name">{{ $catMakeup }}</h3>
                    <p class="category-desc">{{ $catMakeupDesc }}</p>
                    <span class="category-link">{{ $viewAll }} →</span>
                </div>
            </a>
            
            <a href="/{{ $lang }}/{{ $haircareSlug }}/" class="category-card">
                <div class="category-image">
                    <img src="/images/categories/haircare.webp?v=2" alt="{{ $catHaircare }}" loading="lazy">
                    <div class="category-overlay"></div>
                </div>
                <div class="category-content">
                    <div class="category-icon"><img src="/images/icons/icon-haircare.webp?v=2" alt=""></div>
                    <h3 class="category-name">{{ $catHaircare }}</h3>
                    <p class="category-desc">{{ $catHaircareDesc }}</p>
                    <span class="category-link">{{ $viewAll }} →</span>
                </div>
            </a>
        </div>
    </div>
</section>

<!-- ============================================================================
     SECTION 4: NEW ARRIVALS (Latest Products)
============================================================================= -->
{{ $allProducts := where site.RegularPages "Section" "in" (slice "perfumes" "skincare" "makeup" "haircare") }}
{{ $latestProducts := first 8 (sort $allProducts "Date" "desc") }}
{{ if $latestProducts }}
<section class="latest-section">
    <div class="latest-container">
        <div class="section-header-flex">
            <div>
                <h2 class="section-title">{{ $latestTitle }}</h2>
                <p class="section-subtitle">{{ $latestSubtitle }}</p>
            </div>
            <a href="/{{ $lang }}/{{ $perfumesSlug }}/" class="view-all-link">
                {{ $viewAll }} 
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
            </a>
        </div>
        
        <div class="products-grid">
            {{ range $latestProducts }}
            {{ partial "product-card.html" . }}
            {{ end }}
        </div>
    </div>
</section>
{{ end }}

